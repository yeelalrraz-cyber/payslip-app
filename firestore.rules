rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email.lower() == 'OWNER_EMAIL';
    }
    function isMember() {
      return isOwner() || (signedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.token.email.lower())));
    }
    // Who may use the app: only the owner adds or removes people
    match /members/{email} {
      allow read: if isMember();
      allow write: if isOwner();
    }
    // Caregivers, payslips and rates
    match /payroll/{document=**} {
      allow read, write: if isMember();
    }
  }
}
